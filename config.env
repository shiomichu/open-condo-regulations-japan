# マンション名（表紙と本文で共通）
MANSION_NAME="○○マンション"

# 改訂版の情報
VERSION="2026年6月改訂版_草案"

#人数
RIJITYO_NUM="1"
FUKURIJITYO_NUM="2"
KAIKEIRIJI_NUM="1"
#↓理事長・副理事長・会計を含む理事の数
RIJI_SUM_NUM="6"
KANJI_NUM="1"
#任期(年)
NINKI_NUM="1"
#報告間隔
#↓「理事長は ○ か月に１回以上、職務執行状況を理事会に報告する。」
KANKAKU_NUM="1"
#理事会招集
#↓理事が ○ 分の１以上の同意を得て招集を請求した場合、理事長は速やかに理事会を招集しなければならない。
SHOSHU_BUNBO="2"
#↓前項の請求があった日から ○ 日以内に、
HASSURU="14"
#↓請求日から ○ 日以内の日を会日とする招集通知が発せられない場合、請求した理事は理事会を招集できる。
KAISAI="28"
#会計年度
KAIKEINENDO="毎年6月1日から翌年5月31日まで"
#管理費未納利息
#↓組合員が納入期日までに納入しない場合、管理組合は未払金額に対し、年利○％の遅延損害金、(略)請求できる。
RISOKU="10"
#地裁の場所
CHISAI="東京地方（簡易）裁判所"
#市区町村
SIKUCHOSON="○○市"
#発行日
HAKKOUBI="○年○月○日"



# 民泊許可状況に応じて１つtrue
MINPAKU_ALLOWED=false   #民泊を許可する場合true、禁止する場合false
MINPAKU_PROHIBITED=true #民泊を禁止する場合true、許可する場合false

# 電磁的方法状況に応じて１つtrue
ELECTRONIC=true         #認める場合true、禁止する場合false
ELECTRONIC_FALSE=false  #電磁的方法が使えない（書面のみ）場合true、使える場合false

# 暴力団排除条項を入れる場合true、入れない場合false
BORYOKUDAN_RULE=true

#　ペット可否状況に応じて１つtrue
PET_NOT_ALLOWED=false     #禁止
PET_ALLOWED=false         #許可
PET_SMALL_ONLY=true       #小型のみ

# 防火管理者が必要な規模の場合true、いらない場合false
FIRE_MANAGER=true
